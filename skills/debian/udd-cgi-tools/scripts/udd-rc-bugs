#!/usr/bin/env python3
"""CLI: Fetch RC bugs for a Debian suite from UDD."""

import argparse
import sys
import os
sys.path.insert(0, os.path.dirname(__file__))
from udd_cgi import UDDClient


def main():
    parser = argparse.ArgumentParser(description="Fetch RC bugs from UDD")
    parser.add_argument("suite", nargs="?", default="forky",
                        help="Suite name (forky, trixie, sid, bookworm, etc.)")
    parser.add_argument("--key-only", action="store_true",
                        help="Show only key packages")
    parser.add_argument("--json", action="store_true",
                        help="Output as JSON")
    parser.add_argument("--limit", type=int, default=0,
                        help="Limit number of results (0 = all)")
    args = parser.parse_args()

    client = UDDClient()
    bugs = client.rc_bugs(args.suite, args.key_only)

    if args.limit:
        bugs = bugs[:args.limit]

    if args.json:
        import json
        print(json.dumps([{
            "package": b.package,
            "bug": b.bug_number,
            "severity": b.severity,
            "key_package": b.affects_key_package,
            "description": b.description
        } for b in bugs], indent=2))
    else:
        for b in bugs:
            key = " [KEY]" if b.affects_key_package else ""
            print(f"{b.package:30s} #{b.bug_number:<7d} {b.severity:<10s}{key}")
        print(f"\nTotal: {len(bugs)} RC bugs for {args.suite}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
