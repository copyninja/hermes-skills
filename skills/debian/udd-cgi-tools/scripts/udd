#!/usr/bin/env python3
"""UDD CGI Tools - Unified CLI for querying Ultimate Debian Database."""

import argparse
import sys
import os
import re

sys.path.insert(0, os.path.dirname(__file__))

from udd_cgi import (
    UDDClient,
    get_rc_bugs,
    get_patches_for_packages,
    get_ftbfs,
    get_maintainer_summary,
    RCBug,
    PatchBug,
    FTBFSEntry,
    DDPOEntry,
)


def cmd_rc_bugs(args):
    client = UDDClient()
    bugs = client.rc_bugs(args.suite, args.key_only)
    if args.limit:
        bugs = bugs[:args.limit]
    if args.json:
        import json
        print(json.dumps([{
            "package": b.package,
            "bug": b.bug_number,
            "severity": b.severity,
            "title": b.title,
            "hints": b.hints,
            "rt_tags": b.rt_tags,
            "modified": b.modified,
        } for b in bugs], indent=2))
    else:
        for b in bugs:
            key = " [KEY]" if b.affects_key_package else ""
            print(f"{b.package:30s} #{b.bug_number:<7d} {b.severity:<10s}{key}")
            if args.verbose and b.title:
                print(f"  {b.title[:100]}")
        print(f"\nTotal: {len(bugs)} RC bugs for {args.suite}")


def cmd_patches(args):
    bugs = get_patches_for_packages(args.packages if args.packages else None)
    if args.limit:
        bugs = bugs[:args.limit]
    if args.json:
        import json
        print(json.dumps([{
            "package": b.package,
            "bug": b.bug_number,
            "url": b.url
        } for b in bugs], indent=2))
    else:
        for b in bugs:
            print(f"{b.package:30s} #{b.bug_number:<7d} {b.url}")
        print(f"\nTotal: {len(bugs)} bugs with patches")


def cmd_ftbfs(args):
    client = UDDClient()
    entries = client.ftbfs(args.arch, args.release)
    if args.limit:
        entries = entries[:args.limit]
    if args.json:
        import json
        print(json.dumps([{
            "package": e.package,
            "bug": e.bug_number,
        } for e in entries], indent=2))
    else:
        for e in entries:
            bug = f" #{e.bug_number}" if e.bug_number else ""
            print(f"{e.package:30s}{bug}")
        print(f"\nTotal: {len(entries)} FTBFS packages on {args.arch}/{args.release}")


def cmd_dashboard(args):
    entries = get_maintainer_summary(args.email)
    if args.rc_only:
        entries = [e for e in entries if e.rc > 0]
    if args.limit:
        entries = entries[:args.limit]
    if args.json:
        import json
        print(json.dumps([{
            "package": e.package,
            "total": e.total,
            "rc": e.rc,
            "done": e.done,
            "pending": e.pending,
            "forwarded": e.forwarded
        } for e in entries], indent=2))
    else:
        for e in entries:
            print(f"{e.package:30s} total={e.total:4d} rc={e.rc:3d} done={e.done:3d} pending={e.pending:3d} forwarded={e.forwarded:3d}")
        print(f"\nTotal: {len(entries)} packages for {args.email}")


def cmd_autoremovals(args):
    client = UDDClient()
    text = client.autoremovals()
    entries = []
    current_maintainer = None
    for line in text.strip().split("\n"):
        line = line.strip()
        if not line or line.startswith("http") or line.startswith("generated"):
            continue
        if "@" in line and line.endswith(">"):
            current_maintainer = line
        elif current_maintainer and line and ":" in line:
            pkg, rest = line.split(":", 1)
            pkg = pkg.strip()
            if pkg and not pkg.startswith("***"):
                entries.append({"maintainer": current_maintainer, "package": pkg, "details": rest.strip()})
    if args.limit:
        entries = entries[:args.limit]
    if args.json:
        import json
        print(json.dumps(entries, indent=2))
    else:
        for e in entries:
            print(f"{e['package']:30s} {e['maintainer']:40s} {e['details'][:80]}")
        print(f"\nTotal: {len(entries)} packages flagged for autoremoval")


def cmd_wnpp(args):
    client = UDDClient()
    html = client.wnpp_checks()
    from bs4 import BeautifulSoup
    soup = BeautifulSoup(html, "html.parser")
    entries = []
    for link in soup.find_all("a", href=True):
        href = link["href"]
        if "bugs.debian.org" in href:
            bug_match = re.search(r'/(\d+)', href)
            bug_num = bug_match.group(1) if bug_match else ""
            link_text = link.get_text(strip=True)
            parent_text = link.parent.get_text(strip=True) if link.parent else ""
            pkg_match = re.match(r"([^:#]+):", parent_text)
            package = pkg_match.group(1) if pkg_match else ""
            type_match = re.search(r'\((\w+)\)', link_text)
            wnpp_type = type_match.group(1) if type_match else ""
            entries.append({"bug": bug_num, "package": package, "type": wnpp_type, "context": parent_text})
    if args.limit:
        entries = entries[:args.limit]
    if args.json:
        import json
        print(json.dumps(entries, indent=2))
    else:
        for e in entries:
            print(f"#{e['bug']:<7s} {e['type']:<4s} {e['package']:40s} {e['context'][:80]}")
        print(f"\nTotal: {len(entries)} WNPP entries")


def main():
    parser = argparse.ArgumentParser(description="UDD CGI Tools - Query Ultimate Debian Database")
    subparsers = parser.add_subparsers(dest="command", required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="Output as JSON")
    common.add_argument("--limit", type=int, default=0, help="Limit results")
    common.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    p = subparsers.add_parser("rc-bugs", help="RC bugs for a suite", parents=[common])
    p.add_argument("suite", nargs="?", default="forky", help="Suite (forky, trixie, sid, etc.)")
    p.add_argument("--key-only", action="store_true", help="Key packages only")
    p.set_defaults(func=cmd_rc_bugs)

    p = subparsers.add_parser("patches", help="Bugs with patches", parents=[common])
    p.add_argument("packages", nargs="*", help="Filter by package names")
    p.set_defaults(func=cmd_patches)

    p = subparsers.add_parser("ftbfs", help="FTBFS packages", parents=[common])
    p.add_argument("--arch", default="amd64", help="Architecture")
    p.add_argument("--release", default="trixie", help="Release")
    p.set_defaults(func=cmd_ftbfs)

    p = subparsers.add_parser("dashboard", help="Maintainer dashboard", parents=[common])
    p.add_argument("email", help="Maintainer email")
    p.add_argument("--rc-only", action="store_true", help="Only packages with RC bugs")
    p.set_defaults(func=cmd_dashboard)

    p = subparsers.add_parser("autoremovals", help="Autoremoval candidates", parents=[common])
    p.set_defaults(func=cmd_autoremovals)

    p = subparsers.add_parser("wnpp", help="WNPP packages", parents=[common])
    p.set_defaults(func=cmd_wnpp)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    sys.exit(main())
